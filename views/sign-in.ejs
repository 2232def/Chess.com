<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In - Chess Game</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-900 min-h-screen flex items-center justify-center">

    <div id="clerk-signin"></div>
    
    <!-- We will load Clerk via module import -->
    <script type="module">
        import { Clerk } from 'https://esm.sh/@clerk/clerk-js@5';

        const publishableKey = '<%= clerkPublishableKey || process.env.CLERK_PUBLISHABLE_KEY %>';
        const clerk = new Clerk(publishableKey);

        await clerk.load();

        const signInDiv = document.getElementById('clerk-signin');
        clerk.mountSignIn(signInDiv, {
            fallbackRedirectUrl: '/'
        });
    </script>
</body>

</html>